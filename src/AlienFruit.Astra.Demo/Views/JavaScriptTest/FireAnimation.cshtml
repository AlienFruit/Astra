@using AlienFruit.Astra.Core
@using AlienFruit.Astra.Models
@using System.Reflection
@inject AstraEngine AstraEngine

@{
    ViewData["Title"] = "Fire Animation Test";
}

<div class="text-center mb-4">
    <h1 class="display-4">Fire Animation JavaScript Test</h1>
    <p class="lead">Эта страница демонстрирует динамическую загрузку JavaScript из внешнего файла через view-box.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h3 class="mb-0">Эффект огня</h3>
    </div>
    <div class="card-body">
        <p>Наблюдайте за эффектом огня на canvas ниже. JavaScript загружается из внешнего файла <code>fire.js</code>.</p>
        <canvas id="waveCanvas" width="800" height="400" style="border: 2px solid #dc3545; border-radius: 8px; width: 100%; max-width: 800px; height: auto; background: #000000;"></canvas>
        <div class="mt-3">
            <span>Активных элементов: <strong id="waveCount">0</strong></span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-success text-white">
        <h3 class="mb-0">Информация о загрузке</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-success">
            <strong>Успешно!</strong> JavaScript был загружен динамически из внешнего файла через view-box и выполнен на этой странице.
        </div>
        <p>Этот JavaScript код загружается из внешнего файла <code>fire.js</code> через тег <code>&lt;script src="..."&gt;&lt;/script&gt;</code> и выполняется только после того, как контент был загружен в view-box.
           Это демонстрирует возможность динамической загрузки и выполнения скриптов из внешних файлов.</p>
    </div>
</div>


<script src="~/js/fire.js" asp-append-version="true"></script>

<script>
    console.log('Инициализация эффекта огня на странице...');
    const canvas = document.getElementById('waveCanvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');

        // Настраиваем размер canvas
        window.fireResizeCanvas();
        window.fireResizeHandler = window.fireResizeCanvas;
        window.addEventListener('resize', window.fireResizeHandler);

        // Запускаем анимацию
        window.fireAnimate(canvas, ctx);
    } else {
        console.error('Canvas элемент не найден!');
    }
</script>