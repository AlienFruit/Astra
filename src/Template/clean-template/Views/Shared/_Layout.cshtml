@using AlienFruit.Astra.Core
@using AlienFruit.Astra.Models
@using System.Reflection
@inject AstraEngine AstraEngine

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - $ext_safeprojectname$</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    @AstraEngine.RenderHeaders()
    <script>
        function onTimeoutAfterStartLoading(){
            document.getElementById('loading-icon').style.visibility = 'visible';
        }

        function onFinishLoading(){
            document.getElementById('loading-icon').style.visibility = 'hidden';
        }
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <view-box-link id="brand-link"
                    default-class-name="navbar-brand"
                    view-box-id="main-view-box1"
                    uri="/Home">
                    <img src="https://via.placeholder.com/30x30?text=Astra" alt="$ext_safeprojectname$" />
                </view-box-link>
                <span id="loading-icon" style="visibility: hidden;">Loading...</span>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <view-box-link id="home-link1"
                                selected-class-name="nav-link text-dark active"
                                default-class-name="nav-link"
                                view-box-id="main-view-box1"
                                uri="/Home">Home</view-box-link>
                        </li>
                        <li class="nav-item">
                            <view-box-link id="privacy-link1"
                                selected-class-name="nav-link text-dark active"
                                default-class-name="nav-link"
                                view-box-id="main-view-box1"
                                uri="/Home/Privacy">Privacy</view-box-link>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <view-box id="main-view-box1" class="pb-3" role="main"
                on-timeout-after-start-loading-js-function="onTimeoutAfterStartLoading"
                on-finish-loading-js-function="onFinishLoading"
                connection-error-message-resource="@(new InMemoryResource("connection-error", "<div class='alert alert-danger'>Failed to connect to server.</div>"))">
                @RenderBody()
            </view-box>
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - $ext_safeprojectname$ - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
