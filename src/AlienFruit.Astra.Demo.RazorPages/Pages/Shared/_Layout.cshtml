@using AlienFruit.Astra.Core
@using AlienFruit.Astra.Models
@using System.Reflection
@inject AstraEngine AstraEngine

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlienFruit.Astra.Demo.RazorPages</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlienFruit.Astra.Demo.RazorPages.styles.css" asp-append-version="true" />
    @AstraEngine.RenderHeaders()
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">AlienFruit.Astra.Demo.RazorPages</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <view-box-link id="home-link"
                                selected-class-name="nav-link text-primary active"
                                default-class-name="nav-link text-dark"
                                view-box-id="main-view-box1"
                                uri="/Index">Home</view-box-link>
                        </li>
                        <li class="nav-item">
                            <view-box-link id="privacy-link"
                                selected-class-name="nav-link text-primary active"
                                default-class-name="nav-link text-dark"
                                view-box-id="main-view-box1"
                                uri="/Privacy">Privacy</view-box-link>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <view-box id="main-view-box1" class="pb-3" role="main"
            connection-error-message-resource="@(new InMemoryResource("connection-error", "<div class=\"alert alert-danger\">Failed to connect to server. Please check your internet connection.</div>"))">
            @RenderBody()
        </view-box>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AlienFruit.Astra.Demo.RazorPages -
            <view-box-link id="footer-privacy-link"
                view-box-id="main-view-box1"
                uri="/Privacy">Privacy</view-box-link>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
