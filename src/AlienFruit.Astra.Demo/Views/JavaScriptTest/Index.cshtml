@using AlienFruit.Astra.Core
@using AlienFruit.Astra.Models
@using System.Reflection
@inject AstraEngine AstraEngine

@{
    ViewData["Title"] = "JavaScript Test";
}

<div class="text-center mb-4">
    <h1 class="display-4">JavaScript Dynamic Loading Test</h1>
    <p class="lead">This page demonstrates dynamic JavaScript loading via view-box.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-info text-white">
        <h3 class="mb-0">Interactive Particle Animation</h3>
    </div>
    <div class="card-body">
        <p>Click on the canvas below to create particles. JavaScript is loaded dynamically when this page loads.</p>
        <canvas id="particleCanvas" width="800" height="400" style="border: 2px solid #007bff; border-radius: 8px; cursor: crosshair; width: 100%; max-width: 800px; height: auto;"></canvas>
        <div class="mt-3">
            <button id="clearBtn" class="btn btn-secondary">Clear</button>
            <span class="ms-3">Particles on screen: <strong id="particleCount">0</strong></span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-success text-white">
        <h3 class="mb-0">Loading Information</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-success">
            <strong>Success!</strong> JavaScript was loaded dynamically via view-box and executed on this page.
        </div>
        <p>This JavaScript code is loaded from <code>&lt;script&gt;</code> tag and executes only after content was loaded into view-box.
           This demonstrates the ability to dynamically load and execute scripts from <code>&lt;script&gt;</code> tag.</p>
    </div>
</div>

<script>
    (function() {
        console.log('JavaScript loaded and executed dynamically!');
            
        const canvas = document.getElementById('particleCanvas');
        if (!canvas) return;
            
        const ctx = canvas.getContext('2d');
        const particles = [];
        let animationId;
        let resizeHandler = null;
        let clickHandler = null;
        let mousemoveHandler = null;
        let clearBtnHandler = null;
            
        // Function to clean up all resources
        function cleanup() {
            console.log('Cleaning up JavaScript resources...');

            // Stop animation
            if (animationId) {
                cancelAnimationFrame(animationId);
                animationId = null;
            }
            
            // Remove event handlers
            if (resizeHandler) {
                window.removeEventListener('resize', resizeHandler);
                resizeHandler = null;
            }
            
            if (clickHandler && canvas) {
                canvas.removeEventListener('click', clickHandler);
                clickHandler = null;
            }
            
            if (mousemoveHandler && canvas) {
                canvas.removeEventListener('mousemove', mousemoveHandler);
                mousemoveHandler = null;
            }
            
            if (clearBtnHandler) {
                const clearBtn = document.getElementById('clearBtn');
                if (clearBtn) {
                    clearBtn.removeEventListener('click', clearBtnHandler);
                }
                clearBtnHandler = null;
            }
            
            // Clear particles array
            particles.length = 0;
        }
            
        // Canvas size adaptation
        function resizeCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = Math.min(400, rect.width * 0.5);
        }
            
        resizeCanvas();
        resizeHandler = resizeCanvas;
        window.addEventListener('resize', resizeHandler);
            
        class Particle {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.vx = (Math.random() - 0.5) * 4;
                this.vy = (Math.random() - 0.5) * 4;
                this.life = 1.0;
                this.decay = Math.random() * 0.005 + 0.002; // Slowed decay
                this.size = Math.random() * 5 + 2;
                this.color = `hsl(${Math.random() * 360}, 70%, 60%)`;
            }
                
            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.life -= this.decay;
                this.vy += 0.03; // Reduced gravity
            }
                
            draw() {
                ctx.save();
                ctx.globalAlpha = this.life;
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }
            
        function animate() {
            // Check if elements exist - if page was switched, stop animation
            const particleCountElement = document.getElementById('particleCount');
            if (!particleCountElement || !document.contains(canvas)) {
                console.log('Elements removed from DOM, stopping animation');
                cleanup();
                return;
            }
            
            ctx.clearRect(0, 0, canvas.width, canvas.height);
                
            // Update and draw particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const particle = particles[i];
                particle.update();
                particle.draw();
                    
                if (particle.life <= 0) {
                    particles.splice(i, 1);
                }
            }
                
            // Update counter
            particleCountElement.textContent = particles.length;
                
            // Connect close particles
            ctx.strokeStyle = 'rgba(0, 123, 255, 0.3)';
            ctx.lineWidth = 1;
            for (let i = 0; i < particles.length; i++) {
                for (let j = i + 1; j < particles.length; j++) {
                    const dx = particles[i].x - particles[j].x;
                    const dy = particles[i].y - particles[j].y;
                    const distance = Math.sqrt(dx * dx + dy * dy);
                        
                    if (distance < 100) {
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.stroke();
                    }
                }
            }
                
            animationId = requestAnimationFrame(animate);
        }
            
        // Handle canvas click
        clickHandler = (e) => {
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
                
            // Create particle explosion
            for (let i = 0; i < 20; i++) {
                particles.push(new Particle(x, y));
            }
        };
        canvas.addEventListener('click', clickHandler);
            
        // Handle mouse movement
        mousemoveHandler = (e) => {
            if (e.buttons === 1) { // Left mouse button pressed
                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                particles.push(new Particle(x, y));
            }
        };
        canvas.addEventListener('mousemove', mousemoveHandler);
            
        // Clear button
        const clearBtn = document.getElementById('clearBtn');
        if (clearBtn) {
            clearBtnHandler = () => {
                particles.length = 0;
            };
            clearBtn.addEventListener('click', clearBtnHandler);
        }
            
        // Start animation
        animate();
    })();
</script>


