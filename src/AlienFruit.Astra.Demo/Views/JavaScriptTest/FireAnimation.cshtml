@using AlienFruit.Astra.Core
@using AlienFruit.Astra.Models
@using System.Reflection
@inject AstraEngine AstraEngine

@{
    ViewData["Title"] = "Fire Animation Test";
}

<style>
    .fire-animation-area {
        position: relative;
        width: 100%;
        max-width: 800px;
        height: 400px;
        margin: 0;
        overflow: hidden;
        background: #0A0B1F;
        border: 2px solid #dc3545;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .fire-animation-area canvas {
        display: block;
        width: 100%;
        height: 100%;
        cursor: none;
    }
</style>

<div class="text-center mb-4">
    <h1 class="display-4">Fire Animation JavaScript Test</h1>
    <p class="lead">This page demonstrates dynamic JavaScript loading from external file via view-box.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h3 class="mb-0">Fire Effect</h3>
    </div>
    <div class="card-body">
        <p>Watch the fire effect on the canvas below. JavaScript is loaded from external file <code>fire.js</code>.</p>
        <div class="fire-animation-area">
            <canvas id="waveCanvas"></canvas>
        </div>
        <div class="mt-3">
            <span>Active elements: <strong id="waveCount">0</strong></span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-success text-white">
        <h3 class="mb-0">Loading Information</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-success">
            <strong>Success!</strong> JavaScript was loaded dynamically from external file via view-box and executed on this page.
        </div>
        <p>This JavaScript code is loaded from external file <code>fire.js</code> through <code>&lt;script src="..."&gt;&lt;/script&gt;</code> tag and executes only after content was loaded into view-box.
           This demonstrates the ability to dynamically load and execute scripts from external files.</p>
    </div>
</div>


<script src="~/js/fire.js" asp-append-version="true"></script>

<script>
     window.startFireAnimation('waveCanvas', 'waveCount');
</script>